SERVER_PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to call the API. Defaults to "*"
# (any origin) when unset, which is fine for local dev but should be locked
# down to the deployed front-end origin in production.
CORS_ORIGIN=http://localhost:3000

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_S3_BUCKET_NAME=

# Same Cognito user pool the front end (lets-resolve) authenticates against.
# The API verifies the access token on every request with these.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
